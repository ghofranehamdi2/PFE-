          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- L4 → L5 -->
        <mxCell id="edge-l4-l5" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=0;dashPattern=1 4;endArrow=open;endSize=12;" edge="1" parent="1" source="l4-fusion" target="l5-alert">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- TemporalEngine uses L1-L5 -->
        <mxCell id="edge-orch-l1" value="drives" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=0;dashPattern=1 4;endArrow=open;endSize=12;strokeColor=#808080;" edge="1" parent="1" source="orchestrator" target="l2-score">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-orch-l2" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=0;dashPattern=1 4;endArrow=open;endSize=12;strokeColor=#808080;" edge="1" parent="1" source="orchestrator" target="l3-state">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-orch-l3" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=0;dashPattern=1 4;endArrow=open;endSize=12;strokeColor=#808080;" edge="1" parent="1" source="orchestrator" target="l4-fusion">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-orch-l4" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=0;dashPattern=1 4;endArrow=open;endSize=12;strokeColor=#808080;" edge="1" parent="1" source="orchestrator" target="l5-alert">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Pipeline uses all -->
        <mxCell id="edge-pipeline-l1" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endSize=12;strokeColor=#333333;" edge="1" parent="1" source="main-pipeline" target="l1-attention">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-pipeline-orch" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endSize=12;strokeColor=#333333;" edge="1" parent="1" source="main-pipeline" target="orchestrator">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- TemporalEngine outputs CVOutputPayload -->
        <mxCell id="edge-orch-output" value="creates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endSize=12;strokeColor=#ff6b6b;" edge="1" parent="1" source="orchestrator" target="model-cvoutput">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ LEGEND ============ -->
        <mxCell id="legend" value="&lt;b&gt;LÉGENDE&lt;/b&gt;&lt;br&gt;🟢 L1: Analyseurs (Instantané)&lt;br&gt;🟣 L2: Scores (Lissage)&lt;br&gt;🟡 L3: États (Hysteresis)&lt;br&gt;🔴 L4: Fusion (Priorité)&lt;br&gt;🔴 L5: Alertes (Validation)&lt;br&gt;🟤 Orchestration&lt;br&gt;━━━ Utilisation" style="text;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;whiteSpace=wrap;overflow=hidden;rotatable=0;fillColor=#ffffcc;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="50" y="50" width="200" height="180" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>